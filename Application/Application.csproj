<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<RootNamespace>Musify.Application</RootNamespace>
	<PackageId>Musify.Application</PackageId>
    <Version>0.1.1</Version>
    <Authors>NotS1mp</Authors>
    <RepositoryUrl>https://github.com/XShine555/MusifyBackend</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" Version="10.1.0" />
    <PackageReference Include="MassTransit" Version="9.0.1" />
