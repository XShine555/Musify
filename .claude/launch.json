{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "musify-web",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["--prefix", "web-player", "run", "dev"],
			"port": 3000,
			"autoPort": true
		},
		{
			"name": "musify-api",
			"runtimeExecutable": "dotnet",
			"runtimeArgs": ["run", "--project", "backend/Hosts/Musify.Api"],
			"port": 5111
		},
		{
			"name": "musify-streaming-gateway",
			"runtimeExecutable": "dotnet",
			"runtimeArgs": ["run", "--project", "backend/Hosts/Musify.StreamingGateway"],
			"port": 8081
		}
	]
}
