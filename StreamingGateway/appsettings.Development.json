{
  "StreamTicket": {
    "PublicKeyPath": "D:\\weed\\stream_public.pem",
    "Audience": "media-gateway",
    "Issuer": "musify-webapi",
    "QueryParameterName": "t",
    "MediaPathPrefix": "/media"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },

  "ReverseProxy": {
    "Routes": {
      "media": {
        "ClusterId": "seaweed-filer",
        "Match": { "Path": "/media/{**rest}" },
        "Transforms": [
          { "PathPattern": "/buckets/webapi-storage/{**rest}" }
        ]
      }
    },
    "Clusters": {
      "seaweed-filer": {
        "Destinations": {
          "filer": { "Address": "http://localhost:8888/" }
        }
      }
    }
  }
}
