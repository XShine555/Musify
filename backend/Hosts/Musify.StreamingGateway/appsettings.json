{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "StreamTicket": {
    "PublicKeyPath": "",
    "Audience": "media-gateway",
    "Issuer": "musify-webapi",
    "QueryParameterName": "t",
    "MediaPathPrefix": "/media"
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "ReverseProxy": {
    "Routes": {
      "media": {
        "ClusterId": "seaweed-filer",
        "Match": { "Path": "/media/{**rest}" },
        "Transforms": [
          { "PathPattern": "/buckets/CHANGE_ME/{**rest}" }
        ]
      }
    },
    "Clusters": {
      "seaweed-filer": {
        "Destinations": {
          "filer": { "Address": "http://localhost:8888/" }
        }
      }
    }
  }
}
