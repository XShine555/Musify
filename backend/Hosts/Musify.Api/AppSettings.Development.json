{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Authentication": {
        "Scopes": [ "openid", "profile", "email" ],
        "RequireHttpsMetadata": false
    },
    "Database": {
        "ConnectionString": "Host=localhost;Port=59000;Database=musify_db;Username=postgres;Password=postgres"
    },
    "MassTransit": {
        "Address": "rabbitmq://localhost:5672",
        "Username": "guest",
        "Password": "guest"
    },
    "InfrastructureStorage": {
        "Address": "http://localhost:8333",
        "AccessKey": "admin_access_key",
        "SecretAccessKey": "admin_secret_key",
        "ForcePathStyle": true,
        "UseHttp": true
    },
    "ApplicationStorage": {
        "Bucket": "webapi-storage"
    },
    "StreamGateway": {
        "PublicBaseUrl": "http://localhost:8081"
    },
    "StreamTicket": {
        "PrivateKeyPath": "../../../deploy/keys/stream_private.pem"
    },
    "OpenTelemetry": {
        "OtlpEndpoint": "http://localhost:4317"
    },
    "Workers": {
        "Routes": {
            "TemporaryFilesDirectory": "../../../deploy/.tmp"
        }
    }
}
