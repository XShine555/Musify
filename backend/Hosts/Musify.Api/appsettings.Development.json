{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Authentication": {
        "MetadataAddress": "http://host.docker.internal:8080/.well-known/openid-configuration",
        "IssuerAddress": "http://host.docker.internal:8080",
        "AuthorizationEndpoint": "http://host.docker.internal:8080/oauth/v2/authorize?prompt=login",
        "TokenEndpoint": "http://host.docker.internal:8080/oauth/v2/token",
        "ScalarRedirectUri": "http://localhost:5111/scalar/",
        "Scopes": [ "openid", "profile", "email" ],
        "RequireHttpsMetadata": false
    },
    "Database": {
        "ConnectionString": "Host=localhost;Port=5432;Database=musify_db;Username=musify;Password=musify"
    },
    "MassTransit": {
        "Address": "rabbitmq://localhost:5672/musify",
        "Username": "musify",
        "Password": "musify"
    },
    "InfrastructureStorage": {
        "Address": "http://localhost:8333",
        "AccessKey": "musify_access_key",
        "SecretAccessKey": "musify_secret_key",
        "ForcePathStyle": true,
        "UseHttp": true
    },
    "ApplicationStorage": {
        "Bucket": "webapi-storage"
    },
    "StreamGateway": {
        "PublicBaseUrl": "http://localhost:8081"
    },
    "StreamTicket": {
        "PrivateKeyPath": "../../../deploy/keys/stream_private.pem"
    },
    "OpenTelemetry": {
        "OtlpEndpoint": "http://localhost:4317"
    },
    "Workers": {
        "Routes": {
            "TemporaryFilesDirectory": "../../../deploy/.tmp"
        }
    }
}
