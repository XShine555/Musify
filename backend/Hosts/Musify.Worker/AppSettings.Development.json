{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Database": {
        "ConnectionString": "Host=localhost;Port=59000;Database=musify_db;Username=postgres;Password=postgres"
    },
    "MassTransit": {
        "Address": "rabbitmq://localhost:5672",
        "Username": "guest",
        "Password": "guest"
    },
    "OpenTelemetry": {
        "OtlpEndpoint": "http://localhost:4317"
    },
    "InfrastructureStorage": {
