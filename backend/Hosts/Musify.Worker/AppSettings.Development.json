        "AccessKey": "admin_access_key",
        "SecretAccessKey": "admin_secret_key",
        "ForcePathStyle": true,
        "UseHttp": true
    },
    "ApplicationStorage": {
        "Bucket": "webapi-storage"
    },
    "AudioTranscoder": {
        "Routes": {
