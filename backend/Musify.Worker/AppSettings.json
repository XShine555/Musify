{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "ConnectionStrings": {
        "Default": ""
    },
    "Database": {
        "ConnectionString": "Host=localhost;Port=59000;Database=musify_db;Username=postgres;Password=postgres"
    },
    "Keycloak": {
        "BaseUrl": "1",
        "Realm": "1",
        "Username": "1",
        "Password": "1"
    },
    "MassTransit": {
        "Address": "rabbitmq://127.0.0.1:5672",
        "Username": "guest",
        "Password": "guest"
    },
    "OpenTelemetry": {
        "OtlpEndpoint": "http://localhost:4317"
    },
    "ApplicationStorage": {
        "Bucket": "webapi-storage"
    },
    "InfrastructureStorage": {
        "Address": "http://localhost:8333",
        "AccessKey": "admin_access_key",
        "SecretAccessKey": "admin_secret_key",
        "ForcePathStyle": true,
        "UseHttp": true
    },
    "PlayList": {
        "Routes": {
            "ParentFolders": "PlayLists",
            "OriginalPicturesFolder": "OriginalPictures",
            "SmallPicturesFolder": "SmallPictures",
            "MediumPicturesFolder": "MediumPictures",
            "LargePicturesFolder": "LargePictures"
        },
        "PicturesSizes": {
            "SmallPictureWidth": 128,
            "SmallPictureHeight": 128,
            "MediumPictureWidth": 256,
            "MediumPictureHeight": 256,
            "LargePictureWidth": 512,
            "LargePictureHeight": 512
        }
    },
    "Track": {
        "Routes": {
            "ParentFolder": "Tracks",
            "OriginalPicturesFolder": "OriginalPictures",
            "SmallPicturesFolder": "SmallPictures",
            "MediumPicturesFolder": "MediumPictures",
            "LargePicturesFolder": "LargePictures",
            "PresetOriginalPicture": "PresetOriginalPicture.webp",
            "PresetSmallPicture": "PresetSmallPicture.webp",
            "PresetMediumPicture": "PresetMediumPicture.webp",
            "PresetLargePicture": "PresetLargePicture.webp",
            "OriginalAudiosFolder": "OriginalAudios",
            "ProcessedAudioFolder": "ProcessedAudios"
        },
        "PicturesSizes": {
            "SmallPictureWidth": 128,
            "SmallPictureHeight": 128,
            "MediumPictureWidth": 256,
            "MediumPictureHeight": 256,
            "LargePictureWidth": 512,
            "LargePictureHeight": 512
        }
    },
    "AudioTranscoder": {
        "Routes": {
            "WorkingDirectory": "D:\\tempsFilesDev"
        },
        "TranscodingTimeout": "00:05:00"
    },
    "YtDlp": {
        "ExecutableName": "yt-dlp",
        "Format": "bestaudio",
        "AdditionalArguments": "",
        "DownloadTimeout": "00:05:00"
    },
    "Workers": {
        "Routes": {
            "TemporaryFilesDirectory": "D:\\tempsFilesDev"
        }
    },
    "UploadIntent": {
        "UploadUrlExpiresInSeconds": 120,
        "MaxActiveUploadIntentsPerUser": 5,
        "MaxActiveUploadBytesPerUser": 209715200,
        "MaxUploadBytes": 104857600,
        "DefaultExpectedPictureSizeBytes": 10485760,
        "DefaultExpectedAudioSizeBytes": 104857600,
        "ExpirationJobIntervalSeconds": 300,
        "ExpiredIntentsRetentionDays": 7,
        "TempRootPrefix": "temp",
        "TempUploadsRetentionDays": 3,
        "TempCleanupJobIntervalSeconds": 3600
    }
